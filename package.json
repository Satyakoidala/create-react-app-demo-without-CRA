{
	"name": "@satyakodes/create-react-app",
	"version": "0.0.1-5",
	"description": "Setup demo for creating react application without using CRA or any other framework",
	"preferGlobal": true,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "webpack-dev-server --env development",
		"build": "webpack --env production",
		"clean": "npm cache clean --force && rm -rf package-lock.json ./node_modules/ ./dist/",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "eslint src/**/*.js",
		"lint:css": "stylelint src/**/*.scss",
		"clean-install": "npm run clean && npm i",
		"test": "test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Satyakoidala/create-react-app-demo-without-CRA.git"
	},
	"keywords": [
		"react-startup-template",
		"initial-setup",
		"no-cra",
		"react-template-with-webpack",
		"webpack",
		"webpack-dev",
		"github-actions",
		"CI-ready",
		"lint-configured"
	],
	"author": "Koidala Veera Venkata Satya Sai",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Satyakoidala/create-react-app-demo-without-CRA/issues"
	},
	"homepage": "https://github.com/Satyakoidala/create-react-app-demo-without-CRA#readme",
	"devDependencies": {
		"@babel/core": "^7.26.8",
		"@babel/eslint-parser": "^7.26.8",
		"@babel/plugin-transform-runtime": "^7.26.8",
		"@babel/preset-env": "^7.26.8",
		"@babel/preset-react": "^7.26.3",
		"@babel/runtime": "^7.26.7",
		"babel-loader": "^9.2.1",
		"classnames": "^2.5.1",
		"css-loader": "^7.1.2",
		"dotenv-webpack": "^8.1.0",
		"eslint": "^9.20.0",
		"eslint-cli": "^1.1.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.1.0",
		"html-webpack-plugin": "^5.6.3",
		"lodash": "^4.17.21",
		"mini-css-extract-plugin": "^2.9.2",
		"path": "^0.12.7",
		"prettier": "^3.4.2",
		"sass": "^1.84.0",
		"sass-loader": "^16.0.4",
		"style-loader": "^4.0.0",
		"stylelint": "^16.14.1",
		"stylelint-config-standard": "^37.0.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"webpack": "^5.97.1",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.0",
		"webpack-merge": "^6.0.1"
	},
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"engines": {
		"node": "^v18.0.0"
	}
}
